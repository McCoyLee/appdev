# ===== 后端服务 =====
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_ENV=dev

# CORS 允许的前端来源（开发期用 *，生产收紧）
CORS_ORIGINS=*

# ===== AI Provider =====
# DeepSeek（默认）。在 https://platform.deepseek.com 充值并生成 Key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Claude（可选）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ===== GitHub =====
# fine-grained PAT，权限至少包含：
#   Contents: read/write
#   Pull requests: read/write
#   Actions: read/write
#   Secrets: read/write（如要让 AI 管理密码本）
#   Workflows: read/write
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# 默认测试仓库（owner/name），M0 联调用
TEST_REPO=
